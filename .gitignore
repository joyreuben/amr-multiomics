*.fastq
*.fastq.gz
*.bam
*.vcf.gz
*.sam
**/raw/*
!**/raw/.gitkeep
__pycache__/
*.pyc
.ipynb_checkpoints/

# CARD database copy + RGI-built BLAST/DIAMOND indexes (rebuildable via `rgi load`/`rgi main`)
/card.json
localDB/
!resistome/raw/*.fna
# ...except the carbapenemase cohort. 99 assemblies at ~5.8 MB would add ~570 MB
# to a .git that is already 357 MB, and unlike the study genomes these are
# regenerable: carbapenemase_cohort.tsv pins the accessions and
# assemble_carbapenemase_cohort.sh pins the pipeline. The derived evidence
# (AMRFinder calls, mob_recon contig reports) is small and is committed.
resistome/raw/pw_*.fna
resistome/raw/pw_reads/
resistome/results/pathogenwatch_west_africa/pathogenwatch-cgmlst.csv
# 2.5 MB cache of the 557x557 cgMLST distance matrix, rebuilt in ~10 s by
# build_cgmlst_tree.py from the cgMLST export. The tree and its annotation
# table, which are what anyone actually reads, are committed.
resistome/results/cgmlst_distance.npy
# mob_recon bulk: chromosome.fasta is ~5.3 MB per genome (~100 MB over the
# subset) and is just the host contigs, not the finding. The reconstructed
# plasmid FASTAs are kept — 7.3 MB total, they are the actual evidence for the
# shared-vehicle claim, and the assemblies they derive from are not committed,
# so regenerating them would mean re-assembling.
resistome/results/pw_*_mob_recon/chromosome.fasta
resistome/results/pw_*_mob_recon/__tmp/
resistome/results/pw_*.log
resistome/results/pw_*_mob_recon/*.log

# Windows alternate-data-stream cruft from copying files through the WSL mount
*:Zone.Identifier

# Pipeline intermediates: QC reports and assembly logs (regenerable; only the
# final .fna in raw/ is kept)
resistome/processed/
